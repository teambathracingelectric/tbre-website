{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "tbre-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Adopt-a-cell donations (see README). No database_id: Wrangler creates the database on
  // first deploy. Secrets: KOFI_VERIFICATION_TOKEN, DONOR_SALT.
  "d1_databases": [
    { "binding": "ADOPT_DB", "database_name": "tbre-adopt-a-cell" }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "teambathracingelectric.com", "custom_domain": true }]
}
