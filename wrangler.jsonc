{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "tbre-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "teambathracingelectric.com", "custom_domain": true }]
}
