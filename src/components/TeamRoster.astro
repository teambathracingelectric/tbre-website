---
import { render } from "astro:content";
import { DIRECTOR_CATEGORY, type TeamCategoryGroup } from "@/lib/content";

interface Props {
  categories: TeamCategoryGroup[];
}

const { categories: allCategories } = Astro.props;

const directors =
  allCategories.find((category) => category.category === DIRECTOR_CATEGORY)
    ?.members ?? [];
const categories = allCategories.filter(
  (category) => category.category !== DIRECTOR_CATEGORY,
);
const directorEntries = await Promise.all(
  directors.map(async (member) => ({
    member,
    Content: (await render(member)).Content,
    hasBody: Boolean(member.body?.trim()),
  })),
);
---

<section class="container mx-auto space-y-20 px-4 py-16">
  {
    directorEntries.map(({ member, Content, hasBody }) => (
      <div
        class="mx-auto flex max-w-2xl flex-col items-center space-y-6 text-center"
        data-reveal-group
      >
        <div
          class="w-48 overflow-hidden rounded-lg border border-zinc-200 bg-white shadow md:w-60"
          data-reveal-item
        >
          <div class="aspect-[434/600] overflow-hidden">
            <img
              src={member.data.image ?? "/placeholder.png"}
              alt={member.data.name}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <div class="space-y-1" data-reveal-item>
          <h2 class="font-bold text-2xl text-zinc-900 md:text-3xl">
            {member.data.link ? (
              <a
                href={member.data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-tbre-yellow transition-all hover:text-tbre-yellow"
              >
                {member.data.name}
              </a>
            ) : (
              member.data.name
            )}
          </h2>
          {member.data.role && (
            <p class="font-semibold text-tbre-blue">{member.data.role}</p>
          )}
        </div>
        {hasBody && (
          <div class="space-y-4 text-zinc-600 leading-relaxed" data-reveal-item>
            <Content />
          </div>
        )}
      </div>
    ))
  }
  {
    categories.map((category) => (
      <div class="space-y-8">
        <div class="flex items-center gap-4">
          <h2 class="font-bold text-2xl text-zinc-900">{category.category}</h2>
          <div class="h-px flex-1 bg-linear-to-r from-tbre-blue to-transparent" />
        </div>

        <div
          class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-6 lg:grid-cols-4 xl:grid-cols-5"
          data-reveal-group
        >
          {category.members.map((member) => (
            <article
              class="overflow-hidden rounded-lg border border-zinc-200 bg-white shadow transition-all hover:-translate-y-1 hover:shadow-lg"
              data-reveal-item
            >
              <div class="relative aspect-[434/600] overflow-hidden">
                {member.data.lead && (
                  <span class="absolute top-2 right-2 z-10 rounded-full bg-tbre-blue px-2.5 py-0.5 font-semibold text-white text-xs">
                    Lead
                  </span>
                )}
                <img
                  src={member.data.image ?? "/placeholder.png"}
                  alt={member.data.name}
                  class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="space-y-1 p-3">
                <h3 class="font-semibold text-sm text-zinc-900 leading-tight md:text-base">
                  {member.data.link ? (
                    <a
                      href={member.data.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline decoration-tbre-yellow transition-all hover:text-tbre-yellow"
                    >
                      {member.data.name}
                    </a>
                  ) : (
                    member.data.name
                  )}
                </h3>
                {member.data.role && (
                  <p class="text-xs text-zinc-600 md:text-sm">{member.data.role}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    ))
  }
</section>
