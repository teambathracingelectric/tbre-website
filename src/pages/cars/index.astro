---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent } from "@/components/ui/card";

const cars = await getCollection("cars");
const sortedCars = cars.sort((a, b) => b.data.year - a.data.year);
---

<Layout
  title="Cars | Team Bath Racing Electric"
  description="A decade of engineering excellence and innovation"
>
  <div class="min-h-screen bg-white">
    <section class="relative h-[40vh] min-h-[300px] w-full">
      <img
        src="/car.jpg"
        alt="Cars"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 to-white">
      </div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="relative z-10 container px-4 text-center">
          <h1
            class="mb-4 text-4xl font-bold tracking-tighter text-white sm:text-5xl md:text-6xl"
          >
            Our Cars
          </h1>
          <p class="mx-auto max-w-2xl text-lg text-white/90">
            A decade of engineering excellence and innovation
          </p>
        </div>
      </div>
    </section>

    <section class="container mx-auto px-4 py-16">
      <div class="mb-12">
        <h2 class="text-center text-2xl font-bold text-zinc-900">
          Racing Through the Years
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-center text-zinc-600">
          Each year, we push the boundaries of what&apos;s possible, creating
          faster and more innovative electric racing cars.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          sortedCars
            .filter((c) => c.data.year !== 2025)
            .map((car) => (
              <a href={`/cars/${car.data.year}`} class="block">
                <Card className="group overflow-hidden border-zinc-200 bg-white transition-all hover:shadow-lg h-full">
                  <CardContent className="p-0">
                    <div class="relative aspect-[4/3] overflow-hidden">
                      <Badge className="z-10 rounded-full absolute right-2 top-2 bg-tbre-blue hover:bg-tbre-blue/90">
                        {car.data.year}
                      </Badge>
                      <img
                        src={car.data.image}
                        alt={car.data.name}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                      <div class="absolute bottom-0 left-0 p-6">
                        <h2 class="text-2xl font-bold text-white">
                          {car.data.name}
                        </h2>
                      </div>
                    </div>
                  </CardContent>
                </Card>
              </a>
            ))
        }
      </div>
    </section>
  </div>
</Layout>
