---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { CarGallery } from "@/components/car-gallery";
import { Card, CardContent } from "@/components/ui/card";
import { ArrowLeftIcon, ArrowRightIcon, ChevronLeftIcon } from "lucide-react";
import ButtonLink from "@/components/button-link.astro";

export async function getStaticPaths() {
  const cars = await getCollection("cars");
  return cars.map((car) => ({
    params: { year: car.data.year.toString() },
    props: { car },
  }));
}

const { car } = Astro.props;
const { year, name, image, text } = car.data;

// Get all cars to determine adjacent years
const allCars = await getCollection("cars");
const sortedCars = allCars.sort((a, b) => b.data.year - a.data.year);
const currentIndex = sortedCars.findIndex((c) => c.data.year === year);
const nextCar = sortedCars[currentIndex - 1];
const previousCar = sortedCars[currentIndex + 1];

const carGalleryImages = [
  {
    url: "/cars/2021/car-1.jpg",
    alt: "Car 1",
  },
  {
    url: "/cars/2021/car-2.jpg",
    alt: "Car 2",
  },
  {
    url: "/cars/2021/car-3.jpg",
    alt: "Car 3",
  },
] as const;

const raceResults = [
  {
    competition: "Formula Student Germany 2023",
    position: "1st",
    category: "Electric Vehicle Class",
    points: 920,
    highlights: ["1st in Engineering Design", "2nd in Acceleration"],
  },
  {
    competition: "Formula Student Netherlands 2023",
    position: "2nd",
    category: "Electric Vehicle Class",
    points: 885,
    highlights: ["1st in Endurance", "1st in Cost Analysis"],
  },
  {
    competition: "Formula Student UK 2023",
    position: "3rd",
    category: "Electric Vehicle Class",
    points: 856,
    highlights: ["1st in Business Plan", "2nd in Skidpad"],
  },
] as const;
---

<Layout
  title={`${name} | Team Bath Racing Electric`}
  description={`Our ${name} car is a masterpiece of engineering and innovation.`}
>
  <div class="min-h-screen bg-white">
    {/* Navigation Section */}
    <section class="border-b bg-white">
      <div
        class="container mx-auto flex items-center justify-between px-4 py-4"
      >
        <ButtonLink href="/cars" variant="ghost" className="gap-2">
          <ChevronLeftIcon className="h-4 w-4" />
          Back to Cars
        </ButtonLink>

        <div class="flex gap-2">
          {
            previousCar && (
              <ButtonLink
                href={`/cars/${previousCar.data.year}`}
                variant="ghost"
                className="gap-2"
              >
                <ArrowLeftIcon className="h-4 w-4" />
                {previousCar.data.year}
              </ButtonLink>
            )
          }
          {
            nextCar && (
              <ButtonLink
                href={`/cars/${nextCar.data.year}`}
                variant="ghost"
                className="gap-2"
              >
                {nextCar.data.year}
                <ArrowRightIcon className="h-4 w-4" />
              </ButtonLink>
            )
          }
        </div>
      </div>
    </section>

    {/* Hero Section */}
    <section class="relative h-[60vh] min-h-[500px] w-full">
      <img
        src={image}
        alt={name}
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 to-white">
      </div>
      <div class="absolute inset-0 flex items-end justify-start p-8">
        <div class="container mx-auto px-4">
          <div>
            <h1
              class="mb-2 text-5xl font-bold tracking-tighter text-white underline decoration-tbre-yellow sm:text-6xl"
            >
              {name}
            </h1>
            <p class="text-xl text-tbre-blue">{year}</p>
          </div>
        </div>
      </div>
    </section>

    <main class="container mx-auto space-y-20 px-4 py-16">
      {/* Overview Section */}
      <section class="grid gap-12 lg:grid-cols-2">
        <div class="space-y-6">
          <h2 class="text-3xl font-bold text-zinc-900">About the Car</h2>
          <p
            class="text-lg text-zinc-600"
            set:html={text || "No description available."}
          />
        </div>
        <img
          src={image}
          alt="Car detail"
          width={600}
          height={400}
          class="mt-16 w-full rounded-lg object-cover"
        />
      </section>

      {/* Specifications Section */}
      <section class="space-y-8">
        <h2 class="text-3xl font-bold text-zinc-900">Specifications</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            [
              { label: "Weight", value: "230 kg" },
              { label: "Top Speed", value: "120 km/h" },
              { label: "Wheelbase", value: "1525 mm" },
              { label: "Track Width", value: "1200 mm" },
              { label: "Suspension", value: "Double Wishbone" },
              { label: "Aerodynamics", value: "Full Package" },
              { label: "Battery", value: "400V System" },
              { label: "Motors", value: "4 x 20kW" },
            ].map((spec) => (
              <Card className="bg-zinc-50">
                <CardContent className="flex flex-col items-center justify-center p-6">
                  <div class="text-center text-2xl font-bold text-tbre-blue">
                    {spec.value}
                  </div>
                  <div class="text-sm text-zinc-600">{spec.label}</div>
                </CardContent>
              </Card>
            ))
          }
        </div>
      </section>

      {/* Gallery Section */}
      <section class="space-y-8">
        <h2 class="text-3xl font-bold text-zinc-900">Gallery</h2>
        <CarGallery images={carGalleryImages} client:load />
      </section>
    </main>

    {/* Race Results Section */}
    <section class="border-y bg-zinc-50 py-20">
      <div class="container mx-auto px-4">
        <h2 class="mb-12 text-center text-3xl font-bold text-zinc-900">
          Race Results
        </h2>
        <div class="space-y-6">
          {
            raceResults.map((result) => (
              <div class="rounded-lg bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div class="space-y-1">
                    <h3 class="text-lg font-semibold text-zinc-900">
                      {result.competition}
                    </h3>
                    <p class="text-sm text-zinc-600">{result.category}</p>
                  </div>
                  <div class="text-right">
                    <div class="text-2xl font-bold text-tbre-blue">
                      {result.position}
                    </div>
                    <div class="text-sm text-zinc-600">
                      {result.points} points
                    </div>
                  </div>
                </div>
                <div class="mt-4 flex flex-wrap gap-2">
                  {result.highlights.map((highlight) => (
                    <span class="rounded-full bg-tbre-blue/10 px-3 py-1 text-sm font-medium text-tbre-blue">
                      {highlight}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
