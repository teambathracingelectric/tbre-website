---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { blogs } from "@/data/blogs";
import {
  ArrowLeftIcon,
  ArrowRightIcon,
  CalendarIcon,
  ClockIcon,
} from "lucide-react";
import ButtonLink from "@/components/button-link.astro";

export function getStaticPaths() {
  return blogs.map((blog) => ({
    params: { slug: blog.slug },
    props: { blog },
  }));
}

const { blog } = Astro.props;

// Helper to get adjacent blogs
function getAdjacentBlogs(slug: string) {
  const index = blogs.findIndex((b) => b.slug === slug);
  const previousBlog = index > 0 ? blogs[index - 1] : null;
  const nextBlog = index < blogs.length - 1 ? blogs[index + 1] : null;
  return { previousBlog, nextBlog };
}

const { previousBlog, nextBlog } = getAdjacentBlogs(blog.slug);
const relatedBlogs = blogs.filter((b) => b.slug !== blog.slug).slice(0, 2);
---

<Layout
  title={`${blog.title} | Team Bath Racing Electric`}
  description={blog.excerpt}
>
  <div class="min-h-screen bg-white">
    {/* Navigation Bar */}
    <div class="border-b">
      <div
        class="container mx-auto flex items-center justify-between px-4 py-4"
      >
        <ButtonLink href="/blog" variant="ghost" className="gap-2">
          <ArrowLeftIcon className="h-4 w-4" />
          Back to Blog
        </ButtonLink>

        <div class="flex gap-2">
          {
            previousBlog && (
              <ButtonLink
                href={`/blog/${previousBlog.slug}`}
                variant="ghost"
                className="gap-2"
              >
                <ArrowLeftIcon className="h-4 w-4" />
                {previousBlog.slug}
              </ButtonLink>
            )
          }
          {
            nextBlog && (
              <ButtonLink
                href={`/blog/${nextBlog.slug}`}
                variant="ghost"
                className="gap-2"
              >
                <ArrowRightIcon className="h-4 w-4" />
                {nextBlog.slug}
              </ButtonLink>
            )
          }
        </div>
      </div>
    </div>

    {/* Hero Section */}
    <div class="relative aspect-[2/1] w-full">
      <img
        src={blog.image}
        alt={blog.title}
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>

    <article>
      {/* Article Content */}
      <div class="container px-4 py-12">
        <div class="mx-auto max-w-3xl">
          {/* Article Header */}
          <div class="mb-8 space-y-4">
            <div
              class="inline-block rounded-full bg-tbre-blue/10 px-3 py-1 text-sm font-medium text-tbre-blue"
            >
              {blog.category}
            </div>
            <h1
              class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl"
            >
              {blog.title}
            </h1>
            <div
              class="flex flex-wrap items-center gap-6 text-sm text-zinc-600"
            >
              <div class="flex items-center gap-2">
                <CalendarIcon className="h-4 w-4" />
                {
                  new Date(blog.date).toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    year: "numeric",
                  })
                }
              </div>
              <div class="flex items-center gap-2">
                <ClockIcon className="h-4 w-4" />
                {blog.readTime}
              </div>
            </div>
            <div class="flex items-center gap-3 pt-2">
              <img
                src={blog.author.image ?? "/placeholder.png"}
                alt={blog.author.name}
                width={40}
                height={40}
                class="rounded-full"
              />
              <div>
                <div class="font-medium text-zinc-900">
                  {blog.author.name}
                </div>
                <div class="text-sm text-zinc-600">
                  {blog.author.role}
                </div>
              </div>
            </div>
          </div>

          {/* Article Body */}
          <div class="prose prose-zinc max-w-none" set:html={blog.content} />

          {/* Related Posts */}
          <div class="mt-16 border-t pt-16">
            <h2 class="mb-8 text-2xl font-bold text-zinc-900">
              Related Articles
            </h2>
            <div class="grid gap-8 sm:grid-cols-2">
              {
                relatedBlogs.map((relatedBlog) => (
                  <a href={`/blog/${relatedBlog.slug}`} class="group block">
                    <div class="relative aspect-[3/2] overflow-hidden rounded-lg">
                      <img
                        src={relatedBlog.image}
                        alt={relatedBlog.title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    </div>
                    <h3 class="mt-4 text-lg font-semibold text-zinc-900 group-hover:text-tbre-blue">
                      {relatedBlog.title}
                    </h3>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </article>
  </div>
</Layout>
