---
import Layout from "@/layouts/Layout.astro";
import ButtonLink from "@/components/button-link.astro";
import { Image } from "astro:assets";

import placeholder from "../../public/placeholder.png";
---

<Layout
  title="Page Not FOund | Team Bath Racing Electric"
  description="The page you are looking for does not exist."
>
  <main class="flex min-h-[80vh] flex-col items-center justify-center py-8">
    <h1 class="text-center text-4xl font-extrabold">404 - Page Not Found</h1>
    <br />
    <p class="text-zinc-900">The page you are looking for does not exist.</p>
    <br />
    <Image src={placeholder} alt="404 Image" width={200} height={200} />
    <br />
    <ButtonLink
      href="/"
      size="lg"
      className="bg-tbre-yellow text-white hover:bg-tbre-yellow/90"
    >
      Go Home
    </ButtonLink>
  </main>
</Layout>
