---
import AutonomousCarousel from "@/components/AutonomousCarousel.astro";
import AutonomousVideos from "@/components/AutonomousVideos.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const stats = [
  { figure: "2019", label: "Founded" },
  { figure: "10", label: "FSUK awards" },
  { figure: "7", label: "Seasons raced" },
];

// Headshots are AI-generated placeholders until real photos are taken.
const teamMembers = [
  {
    name: "James Morris",
    role: "Team Director",
    image: "/autonomous/James.png",
  },
  {
    name: "Ryan Vickery",
    role: "Software Lead",
    image: "/autonomous/Ryan.png",
  },
  {
    name: "Panteha Asadi",
    role: "Electrical Lead",
    image: "/autonomous/Panteha.png",
  },
  {
    name: "Sara Alkhalili",
    role: "Mechanical Lead & Technical Coordinator",
    image: "/autonomous/Sara.png",
  },
];

// Starts on the 2026 team photo, then works through the rest.
const teamPhotos = [
  {
    src: "/autonomous/tbreai-7.jpg",
    alt: "The autonomous sub-team on stage at Formula Student UK 2026",
  },
  {
    src: "/autonomous/tbreai-2.jpg",
    alt: "Team members pushing the ADS-DV down the Silverstone pit lane",
  },
  {
    src: "/autonomous/tbreai-3.jpg",
    alt: "Engineers gathered round a laptop under the team gazebo during testing",
  },
  {
    src: "/autonomous/tbreai-4.jpg",
    alt: "The team lined up behind TBRe's electric car in the Silverstone paddock",
  },
  {
    src: "/autonomous/tbreai-5.jpg",
    alt: "LiDAR and stereo camera sensor rig beside the 2026 Acceleration trophy",
  },
  {
    src: "/autonomous/tbreai-6.jpg",
    alt: "The ADS-DV driving itself through a coned course at Silverstone",
  },
  {
    src: "/autonomous/tbreai-1.jpg",
    alt: "The team celebrating on stage in front of the Team Bath Racing Electric screen",
  },
];

const timeline = [
  {
    year: "2019-20",
    title: "Where it started",
    description:
      "TBRe18 became our first driverless car, converted in-house. At FSUK 2019 it was the only team-built autonomous car to qualify, winning Business Presentation and ADS Design, before the 2020 event moved online.",
    image: "/autonomous/2019.jpg",
    alt: "The 2019 AI team with their converted driverless car and two trophies at Silverstone",
  },
  {
    year: "2021",
    title: "Clean sweep",
    description:
      "Overall winners of the driverless (DDT) class at FSUK, taking five awards: the class win, Overall Static Events, Autonomous Design, Real World AI and Simulation Development.",
    image: "/autonomous/2021.jpg",
    alt: "The 2021 AI team holding the FS-AI DDT class trophy",
  },
  {
    year: "2022-23",
    title: "Two routes to driverless",
    description:
      "In 2022 we won ADS Static Events and Autonomous Design with a car we built ourselves, then switched to the organisers' ADS-DV in 2023 to focus fully on software.",
    image: "/autonomous/2022.jpg",
    alt: "The 2022 AI team sitting on tyres beside two driverless cars on a coned track",
  },
  {
    year: "2024-25",
    title: "The comeback",
    description:
      "Covid stopped a generation of students from joining, and by 2024 the team had to reboot from scratch. At FSUK 2025 we were back: 5th overall and 3rd in the dynamic events.",
    image: "/autonomous/2025.jpg",
    alt: "The 2025 AI team celebrating behind the ADS-DV on the Silverstone start line",
  },
  {
    year: "2026",
    title: "Our latest trophy",
    description:
      "Building on 2025's platform, we put a huge effort into software and brought home the Acceleration win, leaving a strong software base for main-car integration in 2027.",
    image: "/autonomous/2026.JPG",
    alt: "The 2026 AI team at Formula Student UK",
  },
];

const systems = [
  {
    category: "Sense",
    name: "Perception",
    description:
      "Cone detection and classification from camera and LiDAR, moving to a new sensor with custom CUDA kernels.",
  },
  {
    category: "Locate",
    name: "SLAM",
    description:
      "Where the car is and where the track goes, solved at once. Being rebuilt this season.",
  },
  {
    category: "Decide",
    name: "Control",
    description:
      "Path planning and vehicle control, moving to Model Predictive Control.",
  },
  {
    category: "Command",
    name: "VCU",
    description:
      "Mission select, state machine and the safety checks between software and car.",
  },
  {
    category: "Act",
    name: "Emergency Braking",
    description:
      "The EBS: autonomous braking under normal missions, and a fail-safe stop the moment anything looks wrong.",
  },
  {
    category: "Act",
    name: "Autonomous Steering",
    description:
      "A shaft-mounted motor and angle sensor that steer the car without shutting out the driver.",
  },
];

const tools = [
  {
    name: "Sim",
    description:
      "Our own simulator. Every mission runs here before it runs on track, with physics we can change and trust.",
  },
  {
    name: "Logs & Tracking",
    description:
      "MCAP logging and inspection, so any run can be replayed, compared and regression-tested.",
  },
];

const partners = [
  {
    name: "Racelogic",
    tier: "Gold Sponsor",
    description:
      "VBOX data logging and GPS ground truth, so we can measure what the car actually did on track.",
  },
  {
    name: "Vector",
    tier: "Platinum Sponsor",
    description:
      "CAN tooling and licences for the bus between our software and the vehicle control unit.",
  },
  {
    name: "Altium",
    tier: "Gold Sponsor",
    description:
      "PCB design software behind the sensor pod wiring and the actuation control boards.",
  },
  {
    name: "3Dconnexion",
    tier: "Bronze Sponsor",
    description:
      "CAD input hardware used to design the sensor mounts and steering actuation.",
  },
];

// `start` is the point (in seconds) the video jumps to each time it scrolls into
// view. It still loops from the beginning once it reaches the end.
const videos = [
  {
    label: "Live Run",
    src: "/autonomous/TBReAI_2026_Live_Run.mp4",
    start: 50,
  },
  {
    label: "Trackdrive",
    src: "/autonomous/TBReAI_2026_Live_Logs_Run.mp4",
  },
  {
    label: "Acceleration",
    src: "/autonomous/FSUK_26_-_Accelleration_Run.mp4",
  },
  {
    label: "Simulator",
    src: "/autonomous/TBReAI_2026_Sim_Video.mp4",
  },
];

const heroVideo = "/autonomous/TBReAI_2025_FSUK_Montage.mp4";

// Shown under the hero video while it loads, and instead of it with reduced motion.
const heroSlides = [
  { src: "/autonomous/tbreai-2.jpg" },
  { src: "/autonomous/tbreai-1.jpg" },
  { src: "/autonomous/tbreai-4.jpg" },
  { src: "/autonomous/tbreai-6.jpg" },
];
---

<BaseLayout>
  <div class="min-h-screen bg-white">
    <!-- Hero -->
    <section
      id="top"
      class="relative flex min-h-[660px] items-center justify-center overflow-hidden bg-zinc-900"
    >
      <div class="absolute inset-0">
        <AutonomousCarousel
          images={heroSlides}
          video={heroVideo}
          class="h-full w-full"
        />
      </div>

      <!-- Overlay -->
      <div class="absolute inset-0 bg-black/60"></div>

      <!-- Hero content -->
      <div
        class="container relative mx-auto flex min-h-[660px] flex-col items-center justify-center gap-9 px-4 text-center"
      >
        <h1 class="tracking-tighter">
          <span
            class="block font-normal text-5xl leading-tight text-white sm:text-6xl md:text-7xl"
          >
            Welcome to <span class="font-bold">TBRe</span>
          </span>

          <span
            class="mt-4 block font-semibold text-3xl leading-tight text-tbre-yellow sm:text-4xl"
          >
            Autonomous Integration
          </span>
        </h1>

        <nav
          class="flex flex-wrap justify-center gap-6 text-sm font-medium tracking-wide sm:gap-9"
        >
          <a class="text-white transition-opacity hover:opacity-70" href="#team">
            The Team
          </a>

          <a
            class="text-white transition-opacity hover:opacity-70"
            href="#timeline"
          >
            Timeline
          </a>

          <a
            class="text-white transition-opacity hover:opacity-70"
            href="#systems"
          >
            Our Systems
          </a>

          <a
            class="text-white transition-opacity hover:opacity-70"
            href="#in-action"
          >
            In Action
          </a>

          <a
            class="text-white transition-opacity hover:opacity-70"
            href="#partners"
          >
            Partners
          </a>
        </nav>
      </div>
    </section>

    <!-- Team -->
    <section id="team" class="py-20" data-reveal>
      <div class="container mx-auto px-4">
        <div class="mb-6 flex items-center gap-4">
          <h2
            class="font-bold text-3xl text-zinc-900 tracking-tighter sm:text-4xl"
          >
            Meet the Team
          </h2>

          <div
            class="h-px flex-1 bg-gradient-to-r from-tbre-blue to-transparent"
          >
          </div>
        </div>

        <div
          class="mb-12 flex flex-col justify-between gap-8 lg:flex-row lg:items-start"
        >
          <p class="max-w-2xl text-lg leading-relaxed text-zinc-600">
            Seven engineers across software, controls and integration. The leads
            below own each part of the system.
          </p>

          <div class="flex shrink-0 gap-8">
            {
              stats.map((stat) => (
                <div>
                  <div class="font-bold text-xl text-tbre-blue">
                    {stat.figure}
                  </div>

                  <div class="mt-1 text-xs uppercase tracking-wider text-zinc-500">
                    {stat.label}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
          {
            teamMembers.map((member) => (
              <article class="flex flex-col items-center text-center">
                <img
                  src={member.image}
                  alt={`${member.name}, ${member.role}`}
                  class="h-32 w-32 rounded-full bg-zinc-100 object-cover sm:h-44 sm:w-44"
                  loading="lazy"
                />

                <h3 class="mt-5 mb-1.5 font-semibold text-xl leading-tight text-zinc-900">
                  {member.name}
                </h3>

                <p class="text-xs font-medium uppercase tracking-wider text-tbre-orange">
                  {member.role}
                </p>
              </article>
            ))
          }
        </div>

        <div class="mt-14 grid gap-12 lg:grid-cols-[1.25fr_1fr] lg:items-center">
          <AutonomousCarousel
            images={teamPhotos}
            class="h-72 overflow-hidden rounded-lg bg-zinc-100 sm:h-80"
          />

          <div class="space-y-6">
            <p class="text-lg leading-relaxed text-zinc-600">
              We are the sub-team that takes the driver out of the seat. Every
              layer of the autonomous system is written in-house — cone
              detection from camera and LiDAR, mapping and localisation, path
              planning, and the braking and steering hardware that turns a plan
              into movement. Nothing arrives as a black box, so every member
              ends the year having shipped something that ran at racing speed.
            </p>

            <p class="text-lg leading-relaxed text-zinc-600">
              Next season the target is to drive TBRe17 autonomously at Formula
              Student Germany. Getting there means Model Predictive Control for
              planning, a new SLAM system and simulator we own end to end, MCAP
              logging so nothing is debugged twice — and a bigger team of people
              who want to build it.
            </p>

            <ButtonLink href="/gallery">Autonomous gallery →</ButtonLink>
          </div>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section id="timeline" class="py-20" data-reveal>
      <div class="container mx-auto px-4">
        <div class="mb-6 flex items-center gap-4">
          <h2
            class="font-bold text-3xl text-zinc-900 tracking-tighter sm:text-4xl"
          >
            Timeline
          </h2>

          <div
            class="h-px flex-1 bg-gradient-to-r from-tbre-blue to-transparent"
          >
          </div>
        </div>

        <p class="mb-12 max-w-3xl text-lg leading-relaxed text-zinc-600">
          We entered Formula Student's new driverless class in 2019 with a car
          we converted ourselves. Seven seasons and ten awards later, here's how
          we got here.
        </p>

        <!-- Horizontal timeline -->
        <div class="overflow-x-auto pb-4">
          <div class="min-w-[1100px]">
            <div class="relative pt-8">
              <!-- Continuous timeline line -->
              <div class="absolute left-0 right-0 top-2 h-0.5 bg-zinc-200"></div>

              <div class="grid grid-cols-5 gap-5">
                {
                  timeline.map((item) => (
                    <article class="relative flex min-h-[230px] flex-col">
                      <!-- Timeline marker -->
                      <div class="absolute -top-[30px] left-0 h-3 w-3 rounded-full bg-tbre-blue" />

                      <!-- Year -->
                      <div class="mb-1 font-bold text-xl text-tbre-blue">
                        {item.year}
                      </div>

                      <!-- Title -->
                      <div class="mb-3 font-semibold text-base text-tbre-blue">
                        {item.title}
                      </div>

                      <!-- Description -->
                      <p class="mb-4 text-sm leading-relaxed text-zinc-600">
                        {item.description}
                      </p>

                      <!-- Image -->
                      <img
                        src={item.image}
                        alt={item.alt}
                        class="mt-auto h-36 w-full rounded-lg object-cover"
                        loading="lazy"
                      />
                    </article>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Systems -->
    <section id="systems" class="py-20" data-reveal>
      <div class="container mx-auto px-4">
        <div class="mb-6 flex items-center gap-4">
          <h2
            class="font-bold text-3xl text-zinc-900 tracking-tighter sm:text-4xl"
          >
            Our Systems
          </h2>

          <div
            class="h-px flex-1 bg-gradient-to-r from-tbre-blue to-transparent"
          >
          </div>
        </div>

        <p class="mb-10 max-w-3xl text-lg leading-relaxed text-zinc-600">
          Cones in, brake pressure out. Six modules carry the car around the
          track, and two more keep us honest about whether it works.
        </p>

        <div class="mb-5 grid gap-5 lg:grid-cols-[3fr_2fr]">
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              systems.map((system) => (
                <article class="rounded-lg bg-tbre-blue p-5 text-white">
                  <div class="mb-2.5 text-xs font-semibold uppercase tracking-wider text-tbre-yellow">
                    {system.category}
                  </div>

                  <h3 class="mb-2.5 font-semibold text-lg leading-tight">
                    {system.name}
                  </h3>

                  <p class="text-sm leading-relaxed text-white/80">
                    {system.description}
                  </p>
                </article>
              ))
            }
          </div>

          <img
            src="/autonomous/2026_System.jpg"
            alt="LiDAR, stereo cameras and compute unit being fitted to the ADS-DV at Formula Student UK 2026"
            class="h-64 w-full rounded-lg object-cover lg:h-full"
            loading="lazy"
          />
        </div>

        <div class="grid gap-5 lg:grid-cols-3">
          {
            tools.map((tool) => (
              <article class="rounded-lg bg-zinc-100 p-6">
                <div class="mb-2.5 text-xs font-semibold uppercase tracking-wider text-zinc-500">
                  Tools
                </div>

                <h3 class="mb-2.5 font-semibold text-xl text-zinc-900">
                  {tool.name}
                </h3>

                <p class="text-sm leading-relaxed text-zinc-600">
                  {tool.description}
                </p>
              </article>
            ))
          }

          <article
            class="flex flex-col items-start justify-center gap-4 rounded-lg border border-zinc-200 p-6"
          >
            <p class="font-medium leading-relaxed text-zinc-900">
              Want to learn more about these projects and work on them yourself?
            </p>

            <ButtonLink href="/recruitment" variant="orange">
              Join the team →
            </ButtonLink>
          </article>
        </div>
      </div>
    </section>

    <!-- See It in Action -->
    <section id="in-action" class="py-20" data-reveal>
      <div class="container mx-auto px-4">
        <div class="mb-6 flex items-center gap-4">
          <h2
            class="font-bold text-3xl text-zinc-900 tracking-tighter sm:text-4xl"
          >
            See It in Action
          </h2>

          <div
            class="h-px flex-1 bg-gradient-to-r from-tbre-blue to-transparent"
          >
          </div>
        </div>

        <p class="mb-10 max-w-3xl text-lg leading-relaxed text-zinc-600">
          The car at Formula Student UK 2026, and the same runs played back from
          our own logs — what the car saw, where it thought it was, and the line
          it chose.
        </p>

        <AutonomousVideos videos={videos} />
      </div>
    </section>

    <!-- Partners -->
    <section id="partners" class="bg-zinc-50 py-20" data-reveal>
      <div class="container mx-auto px-4">
        <div class="mb-6 flex items-center gap-4">
          <h2
            class="font-bold text-3xl text-zinc-900 tracking-tighter sm:text-4xl"
          >
            Partners
          </h2>

          <div
            class="h-px flex-1 bg-gradient-to-r from-tbre-blue to-transparent"
          >
          </div>
        </div>

        <p class="mb-12 max-w-3xl text-lg leading-relaxed text-zinc-600">
          The autonomous programme runs on hardware, software and expertise
          given to us by the companies below — the same sponsor tiers as the
          main team.
        </p>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            partners.map((partner) => (
              <article class="overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm">
                <!-- Logo placeholder -->
                <div class="flex h-28 items-center justify-center border-b border-zinc-100 bg-zinc-50 p-5">
                  <span class="font-semibold text-zinc-400">{partner.name}</span>
                </div>

                <div class="p-5">
                  <h3 class="mb-1 font-semibold text-lg text-zinc-900">
                    {partner.name}
                  </h3>

                  <p class="mb-3 text-xs uppercase tracking-wider text-tbre-yellow">
                    {partner.tier}
                  </p>

                  <p class="text-sm leading-relaxed text-zinc-600">
                    {partner.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
        <p>PLACEHOLDER SECTION PARTNER DETAILS REQUIRED</p>

        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <ButtonLink href="/sponsors">
            Full Team Sponsorship Prospectus
          </ButtonLink>

          <ButtonLink href="/sponsors" variant="orange">
            Autonomous Team Prospectus
          </ButtonLink>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
