---
import { getCollection } from "astro:content";
import AutonomousCarousel from "@/components/AutonomousCarousel.astro";
import AutonomousVideos from "@/components/AutonomousVideos.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const autonomousPages = await getCollection("autonomous");

const hero = autonomousPages.find((page) => page.data.section === "hero")?.data;

const team = autonomousPages.find((page) => page.data.section === "team")?.data;

const timelineContent = autonomousPages.find(
  (page) => page.data.section === "timeline",
)?.data;

const systemsContent = autonomousPages.find(
  (page) => page.data.section === "systems",
)?.data;

const actionContent = autonomousPages.find(
  (page) => page.data.section === "in-action",
)?.data;

const partnersContent = autonomousPages.find(
  (page) => page.data.section === "partners",
)?.data;

const stats = team?.stats ?? [];
const teamMembers = team?.members ?? [];
const teamParagraphs = team?.paragraphs ?? [];

const timeline = timelineContent?.items ?? [];

const systems = systemsContent?.systems ?? [];
const tools = systemsContent?.tools ?? [];

const partners = partnersContent?.partners ?? [];

// Team gallery photos are still media configuration rather than page copy.
const teamPhotos = [
  {
    src: "/autonomous/tbreai-7.jpg",
    alt: "The autonomous sub-team on stage at Formula Student UK 2026",
  },
  {
    src: "/autonomous/tbreai-2.jpg",
    alt: "Team members pushing the ADS-DV down the Silverstone pit lane",
  },
  {
    src: "/autonomous/tbreai-3.jpg",
    alt: "Engineers gathered round a laptop under the team gazebo during testing",
  },
  {
    src: "/autonomous/tbreai-4.jpg",
    alt: "The team lined up behind TBRe's electric car in the Silverstone paddock",
  },
  {
    src: "/autonomous/tbreai-5.jpg",
    alt: "LiDAR and stereo camera sensor rig beside the 2026 Acceleration trophy",
  },
  {
    src: "/autonomous/tbreai-6.jpg",
    alt: "The ADS-DV driving itself through a coned course at Silverstone",
  },
  {
    src: "/autonomous/tbreai-1.jpg",
    alt: "The team celebrating on stage in front of the Team Bath Racing Electric screen",
  },
];

const videos = [
  {
    label: "Live Run",
    src: "/autonomous/TBReAI_2026_Live_Run.mp4",
    start: 50,
  },
  {
    label: "Autocross",
    src: "/autonomous/TBReAI_2026_Live_Logs_Run.mp4",
  },
  {
    label: "Acceleration",
    src: "/autonomous/FSUK_26_-_Accelleration_Run.mp4",
  },
  {
    label: "Simulator",
    src: "/autonomous/TBReAI_2026_Sim_Video.mp4",
  },
];

const heroVideo = "/autonomous/TBReAI_2025_FSUK_Montage.mp4";

const heroSlides = [
  { src: "/autonomous/tbreai-2.jpg" },
  { src: "/autonomous/tbreai-1.jpg" },
  { src: "/autonomous/tbreai-4.jpg" },
  { src: "/autonomous/tbreai-6.jpg" },
];
---

<BaseLayout>
  <div class="min-h-screen bg-white">
    <!-- Hero -->
    <section
      id="top"
      class="relative flex min-h-[660px] items-center justify-center overflow-hidden bg-zinc-900"
    >
      <div class="absolute inset-0">
        <AutonomousCarousel
          images={heroSlides}
          video={heroVideo}
          class="h-full w-full"
        />
      </div>

      <div class="absolute inset-0 bg-black/60"></div>

      <div
        class="container relative mx-auto flex min-h-[660px] flex-col items-center justify-center gap-9 px-4 text-center"
      >
        <h1 class="tracking-tighter">
          <span
            class="block font-normal text-5xl leading-tight text-white sm:text-6xl md:text-7xl"
          >
            {hero?.title}{" "}
            <span class="font-bold">
              {hero?.subtitle}<span class="text-tbre-yellow">
                {hero?.accent}
              </span>
            </span>
          </span>
        </h1>

        <nav
          class="flex flex-wrap justify-center gap-6 text-sm font-medium tracking-wide sm:gap-9"
        >
          <a
            class="text-white transition-opacity hover:opacity-70"
            href="#team"
          >
            The Team
          </a>

          <a
            class="text-white transition-opacity hover:opacity-70"
            href="#timeline"
          >
            Timeline
          </a>

          <a
            class="text-white transition-opacity hover:opacity-70"
            href="#systems"
          >
            Our Systems
          </a>

          <a
            class="text-white transition-opacity hover:opacity-70"
            href="#in-action"
          >
            In Action
          </a>

          <a
            class="text-white transition-opacity hover:opacity-70"
            href="#partners"
          >
            Partners
          </a>
        </nav>
      </div>
    </section>

    <!-- Team -->
    <section id="team" class="pt-20 pb-10" data-reveal>
      <div class="container mx-auto px-4">
        <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-center">
          <AutonomousCarousel
            images={teamPhotos}
            class="h-72 overflow-hidden rounded-lg bg-zinc-100 sm:h-80"
          />

          <div class="space-y-6">
            {teamParagraphs.map((paragraph) => (
              <p class="text-lg leading-relaxed text-zinc-600">
                {paragraph}
              </p>
            ))}

            <ButtonLink href="/gallery?category=Autonomous">
              {team?.galleryButton}
            </ButtonLink>
          </div>
        </div>

        <div class="mt-20 mb-6 flex items-center gap-4">
          <h2
            class="font-bold text-3xl text-zinc-900 tracking-tighter sm:text-4xl"
          >
            Meet the Team
          </h2>

          <div
            class="h-px flex-1 bg-gradient-to-r from-tbre-blue to-transparent"
          ></div>
        </div>

        <div
          class="mb-12 flex flex-col justify-between gap-8 lg:flex-row lg:items-start"
        >
          <p class="max-w-2xl text-lg leading-relaxed text-zinc-600">
            {team?.intro}
          </p>

          <div class="flex shrink-0 gap-8">
            {stats.map((stat) => (
              <div>
                <div class="font-bold text-xl text-tbre-blue">
                  {stat.figure}
                </div>

                <div
                  class="mt-1 text-xs uppercase tracking-wider text-zinc-500"
                >
                  {stat.label}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
          {teamMembers.map((member) => (
            <article class="flex flex-col items-center text-center">
              <img
                src={member.image}
                alt={`${member.name}, ${member.role}`}
                class="h-32 w-32 rounded-full bg-zinc-100 object-cover sm:h-44 sm:w-44"
                loading="lazy"
              />

              <h3
                class="mt-5 mb-1.5 font-semibold text-xl leading-tight text-zinc-900"
              >
                {member.name}
              </h3>

              <p
                class="text-xs font-medium uppercase tracking-wider text-tbre-orange"
              >
                {member.role}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section id="timeline" class="pt-4 pb-20" data-reveal>
      <div class="container mx-auto px-4">
        <p class="mb-12 max-w-3xl text-lg leading-relaxed text-zinc-600">
          {timelineContent?.intro}
        </p>

        <div class="overflow-x-auto pb-4">
          <div class="min-w-[1100px]">
            <div class="relative pt-8">
              <div
                class="absolute left-0 right-0 top-2 h-0.5 bg-zinc-200"
              ></div>

              <div class="grid grid-cols-5 gap-5">
                {timeline.map((item) => (
                  <article class="relative flex min-h-[230px] flex-col">
                    <div
                      class="absolute -top-[30px] left-0 h-3 w-3 rounded-full bg-tbre-blue"
                    ></div>

                    <div class="mb-1 font-bold text-xl text-tbre-blue">
                      {item.year}
                    </div>

                    <div class="mb-3 font-semibold text-base text-tbre-blue">
                      {item.title}
                    </div>

                    <p class="mb-4 text-sm leading-relaxed text-zinc-600">
                      {item.description}
                    </p>

                    <img
                      src={item.image}
                      alt={item.alt}
                      class="mt-auto h-36 w-full rounded-lg object-cover"
                      loading="lazy"
                    />
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Systems -->
    <section id="systems" class="py-20" data-reveal>
      <div class="container mx-auto px-4">
        <div class="mb-6 flex items-center gap-4">
          <h2
            class="font-bold text-3xl text-zinc-900 tracking-tighter sm:text-4xl"
          >
            Our Systems
          </h2>

          <div
            class="h-px flex-1 bg-gradient-to-r from-tbre-blue to-transparent"
          ></div>
        </div>

        <p class="mb-10 max-w-3xl text-lg leading-relaxed text-zinc-600">
          {systemsContent?.intro}
        </p>

        <div class="mb-5 grid gap-5 lg:grid-cols-[3fr_2fr]">
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {systems.map((system) => (
              <article class="rounded-lg bg-tbre-blue p-5 text-white">
                <div
                  class="mb-2.5 text-xs font-semibold uppercase tracking-wider text-tbre-yellow"
                >
                  {system.category}
                </div>

                <h3 class="mb-2.5 font-semibold text-lg leading-tight">
                  {system.name}
                </h3>

                <p class="text-sm leading-relaxed text-white/80">
                  {system.description}
                </p>
              </article>
            ))}
          </div>

          <img
            src="/autonomous/2026_System.jpg"
            alt="LiDAR, stereo cameras and compute unit being fitted to the ADS-DV at Formula Student UK 2026"
            class="h-64 w-full rounded-lg object-cover lg:h-full"
            loading="lazy"
          />
        </div>

        <div class="grid gap-5 lg:grid-cols-3">
          {tools.map((tool) => (
            <article class="rounded-lg bg-zinc-100 p-6">
              <div
                class="mb-2.5 text-xs font-semibold uppercase tracking-wider text-zinc-500"
              >
                Tools
              </div>

              <h3 class="mb-2.5 font-semibold text-xl text-zinc-900">
                {tool.name}
              </h3>

              <p class="text-sm leading-relaxed text-zinc-600">
                {tool.description}
              </p>
            </article>
          ))}

          <article
            class="flex flex-col items-start justify-center gap-4 rounded-lg border border-zinc-200 p-6"
          >
            <p class="font-medium leading-relaxed text-zinc-900">
              {systemsContent?.joinText}
            </p>

            <ButtonLink href="/recruitment#ai" variant="orange">
              {systemsContent?.joinButton}
            </ButtonLink>
          </article>
        </div>
      </div>
    </section>

    <!-- See It in Action -->
    <section id="in-action" class="py-20" data-reveal>
      <div class="container mx-auto px-4">
        <div class="mb-6 flex items-center gap-4">
          <h2
            class="font-bold text-3xl text-zinc-900 tracking-tighter sm:text-4xl"
          >
            See It in Action
          </h2>

          <div
            class="h-px flex-1 bg-gradient-to-r from-tbre-blue to-transparent"
          ></div>
        </div>

        <p class="mb-10 max-w-3xl text-lg leading-relaxed text-zinc-600">
          {actionContent?.intro}
        </p>

        <AutonomousVideos videos={videos} />
      </div>
    </section>

    <!-- Partners -->
    <section id="partners" class="bg-zinc-50 py-20" data-reveal>
      <div class="container mx-auto px-4">
        <div class="mb-6 flex items-center gap-4">
          <h2
            class="font-bold text-3xl text-zinc-900 tracking-tighter sm:text-4xl"
          >
            Partners
          </h2>

          <div
            class="h-px flex-1 bg-gradient-to-r from-tbre-blue to-transparent"
          ></div>
        </div>

        <p class="mb-12 max-w-3xl text-lg leading-relaxed text-zinc-600">
          {partnersContent?.intro}
        </p>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {partners.map((partner) => (
            <article
              class="overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm"
            >
              <div
                class="flex h-28 items-center justify-center border-b border-zinc-100 bg-zinc-50 p-5"
              >
                {partner.logo ? (
                  <img
                    src={partner.logo}
                    alt={partner.name}
                    class="max-h-16 w-auto max-w-[80%] object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="font-semibold text-zinc-400">
                    {partner.name}
                  </span>
                )}
              </div>

              <div class="p-5">
                <h3 class="mb-1 font-semibold text-lg text-zinc-900">
                  {partner.name}
                </h3>

                <p
                  class="mb-3 text-xs uppercase tracking-wider text-tbre-yellow"
                >
                  {partner.tier}
                </p>

                <p class="text-sm leading-relaxed text-zinc-600">
                  {partner.description}
                </p>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <ButtonLink href="/sponsors">
            {partnersContent?.prospectusButton}
          </ButtonLink>

          <ButtonLink href="/sponsors" variant="orange">
            {partnersContent?.autonomousProspectusButton}
          </ButtonLink>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
