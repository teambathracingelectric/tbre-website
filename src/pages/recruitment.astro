---
import Layout from "@/layouts/Layout.astro";
import { RecruitmentSection } from "@/components/recruitment-section";
import { recruitment } from "@/data/recruitment";

const categories = recruitment.map((team) => ({
  name: team.name,
  href: `#${team.name.toLowerCase().replace(/\s+/g, "-")}`,
}));
---

<Layout
  title="Recruitment | Team Bath Racing Electric"
  description="Join our team! Explore open roles and help us push the boundaries of engineering excellence."
>
  <div class="min-h-screen bg-white">
    <section class="relative h-[50vh] min-h-[400px] w-full">
      <img
        src="/car.jpg"
        alt="Recruitment"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/50 to-white">
      </div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="relative z-10 container px-4 text-center">
          <h1
            class="mb-4 text-4xl font-bold tracking-tighter text-white sm:text-5xl md:text-6xl"
          >
            Join Our Team
          </h1>
          <p class="mx-auto max-w-2xl text-lg text-white/90">
            Explore open roles and help us push the boundaries of engineering
            excellence.
          </p>
        </div>
      </div>
    </section>

    <section class="container mx-auto px-4 pt-16">
      <div class="mb-12 flex flex-wrap items-center justify-center gap-4">
        {
          categories.map((category) => (
            <a
              href={category.href}
              class="cursor-pointer rounded-full bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-900 transition-colors hover:bg-zinc-200"
            >
              {category.name}
            </a>
          ))
        }
      </div>
    </section>

    <RecruitmentSection client:load />
  </div>
</Layout>
