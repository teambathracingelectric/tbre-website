{
  "name": "tbre-website",
  "version": "0.2.0",
  "private": true,
  "description": "Team Bath Racing Electric's official website, built with Astro and Tailwind CSS.",
  "author": "Tom Heaton <tom@tomheaton.dev> (https://tomheaton.dev)",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "clean": "rm -rf node_modules .astro dist",
    "dev": "astro dev",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "lint:fix": "biome check --fix --unsafe",
    "preview": "astro preview",
    "start": "astro preview",
    "typecheck": "astro sync && tsgo -b",
    "unused": "knip --cache",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@lucide/astro": "^1.14.0",
    "astro": "^6.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20260510.1",
    "knip": "^6.12.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "yaml": "^2.8.3"
  },
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.14",
      "yaml-language-server>yaml": "2.8.3"
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}
