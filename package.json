{
  "name": "tbre-website",
  "version": "0.2.0",
  "private": true,
  "description": "Team Bath Racing Electric's official website, built with Astro and Tailwind CSS.",
  "author": "Tom Heaton <tom@tomheaton.dev> (https://tomheaton.dev)",
  "scripts": {
    "build": "astro build",
    "cf:deploy": "astro build && wrangler deploy",
    "cf:preview": "astro build && wrangler dev",
    "check": "astro check",
    "clean": "rm -rf node_modules .astro dist",
    "dev": "astro dev",
    "format": "biome format --write",
    "generate-types": "wrangler types",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "lint:fix": "biome check --fix",
    "optimise:svg": "svgo -rf ./public -o ./public",
    "preview": "astro preview",
    "start": "astro preview",
    "typecheck": "astro sync && tsc -b",
    "unused": "knip --cache",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.1",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@lucide/astro": "^1.23.0",
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "^2.5.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "knip": "^6.24.0",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "7.0.1-rc",
    "wrangler": "^4.107.0",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "26.x",
    "pnpm": "11.x"
  }
}
